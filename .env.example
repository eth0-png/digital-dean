# Скопируйте в .env и заполните. Файл .env в репозиторий не попадает.

# --- Сервер (docker compose) ---
# Домен прототипа, для него Caddy получит HTTPS-сертификат. Без домена: 203.0.113.10.sslip.io (IP машины).
DOMAIN=
# Пароль базы. Только буквы и цифры, он идёт в адрес подключения: openssl rand -hex 24
POSTGRES_PASSWORD=

# --- Локальная разработка (npm run dev) ---
# База из docker-compose.dev.yml. На сервере не нужен, его задаёт docker-compose.yml.
# DATABASE_URL=postgres://dekanat@localhost:54329/dekanat

# --- Пароли тестовых аккаунтов student1, student2, dekanat ---
# Задаются при старте приложения. Поменяли здесь, перезапустили, пароль обновился.
SEED_PASSWORD_STUDENT1=
SEED_PASSWORD_STUDENT2=
SEED_PASSWORD_STAFF=

# --- Только для локальной проверки расписания: «сейчас» для пар и изменений. На сервере не задавать ---
# DEMO_NOW=2026-11-10T10:45:00+03:00

# --- Сброс демо-данных при каждом старте приложения (заявки, переписка, прочитанное, аватарки) ---
# На сервере для жюри: DEMO_RESET=1 и ночной перезапуск приложения по расписанию (см. README).
# DEMO_RESET=1
